---
layout: layouts/base.njk
---
<article class="doc">
  {% if markdownUrl %}
  <div class="ai-actions">
    <span class="ai-actions__label">Use with AI:</span>
    <button type="button" class="ai-actions__copy" data-markdown-url="{{ markdownUrl }}">Copy page as Markdown</button>
    <a href="{{ markdownUrl }}">View as Markdown</a>
    <span class="ai-actions__open">Open in:
      {% for link in aiLinks %}<a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
    </span>
  </div>
  {% endif %}
  {{ content | safe }}
  <div class="image-rail" hidden></div>
  <p class="doc__edit">
    <a href="https://github.com/odin-sons/kg-marketplace-docs/edit/main/{{ page.inputPath | replace('./', '') }}">Edit this page on GitHub</a>
  </p>
</article>
