<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — KG Marketplace Docs</title>
  <meta name="description" content="{{ siteDescription }}">
  {% if noIndex %}<meta name="robots" content="noindex">{% endif %}
  {% if canonicalUrl %}<link rel="canonical" href="{{ canonicalUrl }}">{% endif %}
  <link rel="describedby" href="/llms.txt">
  {% if markdownUrl %}<link rel="alternate" type="text/markdown" href="{{ markdownUrl }}">{% endif %}
  <script>
    // Inline and synchronous — runs before CSS paints, to avoid a flash of the wrong theme.
    (function () {
      try {
        var theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.setAttribute("data-theme", theme);
        }
        if (localStorage.getItem("sidebarCollapsed") === "true") {
          document.documentElement.setAttribute("data-sidebar", "collapsed");
        }
      } catch (e) {}
    })();
  </script>
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" type="image/png" href="/icons/icon-16.png" sizes="16x16">
  <link rel="icon" type="image/png" href="/icons/icon-32.png" sizes="32x32">
  <link rel="icon" type="image/png" href="/icons/icon-192.png" sizes="192x192">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0c0c0c">
  <link rel="stylesheet" href="/styles/site.css">
  <!-- No-JS fallback: undoes the pre-collapsed nav state above. -->
  <noscript><style>#site-nav [hidden] { display: block !important; }</style></noscript>
</head>
<body>
  <pagefind-config bundle-path="{{ pagefindBundlePath }}" base-url="{{ pagefindBaseUrl }}"></pagefind-config>

  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
    <span class="sr-only">Menu</span>
    <span aria-hidden="true">☰</span>
  </button>

  <button class="sidebar-collapse-toggle" type="button" aria-expanded="true" aria-controls="site-nav" aria-label="Collapse sidebar">
    {{ sidebarToggleIcon | safe }}
  </button>

  <nav id="site-nav" class="site-nav">
    <a class="site-nav__home" href="/">
      <img class="site-nav__logo" src="/images/marketplace-logo.png" alt="Marketplace and Server NPCs logo" eleventy:widths="160,320" sizes="160px">
      <span class="site-nav__home-text">Marketplace &amp; Server NPCs</span>
    </a>
    <div class="site-nav__version">
      <label class="sr-only" for="version-switcher">Documentation version</label>
      <select id="version-switcher" class="site-nav__version-select" data-own-version="{{ currentVersion }}">
        {% for v in versions %}
        <option value="{{ v.url }}"{% if v.current %} selected{% endif %}>v{{ v.version }}{% if v.current %} (current){% endif %}</option>
        {% endfor %}
      </select>
    </div>
    <div class="site-nav__theme">
      <label class="sr-only" for="theme-switcher">Theme</label>
      <select id="theme-switcher" class="site-nav__theme-select">
        <option value="auto">Auto theme</option>
        <option value="light">Light theme</option>
        <option value="dark">Dark theme</option>
      </select>
    </div>
    <div class="site-nav__search">
      <pagefind-modal-trigger class="site-nav__search-trigger"></pagefind-modal-trigger>
      <pagefind-modal></pagefind-modal>
    </div>
    <div class="site-nav__group">
      <ul>
        <li><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}><span class="site-nav__link-text">Introduction</span></a></li>
      </ul>
    </div>
    {% for group in navWithState %}
    {% set groupIndex = loop.index0 %}
    <div class="site-nav__group">
      <p class="site-nav__group-title" role="heading" aria-level="2">
        <button type="button" class="site-nav__group-toggle" aria-expanded="{{ group.active }}" aria-controls="nav-group-{{ groupIndex }}">
          <span class="site-nav__group-title-text">
            <span class="site-nav__group-title-main">{{ group.title }}</span>
            {% if group.subtitle %}<span class="site-nav__group-title-sub">{{ group.subtitle }}</span>{% endif %}
          </span>
        </button>
      </p>
      <ul id="nav-group-{{ groupIndex }}"{% if not group.active %} hidden{% endif %}>
        {% for item in group.items %}
        {% set itemIndex = loop.index0 %}
        <li{% if item.children %} class="site-nav__item--has-children"{% endif %}>
          <a href="{{ item.href }}"{% if item.href == page.url %} aria-current="page"{% endif %}{% if item.external %} target="_blank" rel="noopener noreferrer"{% endif %}><span class="site-nav__link-text">{{ item.title }}</span>{% if item.external %}<span class="site-nav__external" aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>{% endif %}</a>
          {% if item.children %}
          <button type="button" class="site-nav__toggle" aria-expanded="{{ item.active }}" aria-controls="nav-children-{{ groupIndex }}-{{ itemIndex }}" aria-label="Toggle {{ item.title }} sub-pages"></button>
          <ul class="site-nav__children" id="nav-children-{{ groupIndex }}-{{ itemIndex }}"{% if not item.active %} hidden{% endif %}>
            {% for child in item.children %}
            <li><a href="{{ child.href }}"{% if child.href == page.url %} aria-current="page"{% endif %}><span class="site-nav__link-text">{{ child.title }}</span></a></li>
            {% endfor %}
          </ul>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </nav>

  <main class="site-main">
    {{ content | safe }}
  </main>

  <script src="/scripts/nav-toggle.js" defer></script>
  <script src="/scripts/sidebar-collapse.js" defer></script>
  <script src="/scripts/nav-collapse.js" defer></script>
  <script src="/scripts/image-lightbox.js" defer></script>
  <script src="/scripts/image-rail.js" defer></script>
  <script src="/scripts/version-switcher.js" defer></script>
  <script src="/scripts/theme-switcher.js" defer></script>
  <script src="/scripts/suggest-correction.js" defer></script>
  <script src="/scripts/anchor-highlight.js" defer></script>
  <script src="/scripts/page-toc.js" defer></script>
  <script src="/scripts/ai-actions.js" defer></script>
  <script src="/scripts/sw-update-banner.js" defer></script>
  <script>
    window.addEventListener("load", function () {
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("{{ swPath }}");
      }

      // Injected here (not a static <link>/<script src>) so the browser's preload scanner
      // never discovers it — a static tag gets fetched immediately regardless of its position
      // in the document, since the scanner reads the whole downloaded HTML up front.
      var link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = "{{ pagefindBundlePath }}pagefind-component-ui.css";
      document.head.appendChild(link);

      var script = document.createElement("script");
      script.type = "module";
      script.src = "{{ pagefindBundlePath }}pagefind-component-ui.js";
      document.body.appendChild(script);
    });
  </script>
</body>
</html>
