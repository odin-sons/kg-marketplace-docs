{
  "name": "kg-marketplace-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "baseline widely available"
  ],
  "scripts": {
    "build": "eleventy",
    "start": "cross-env ELEVENTY_SITE_ORIGIN=http://localhost:8080 ELEVENTY_CANONICAL_ORIGIN=http://localhost:8080 eleventy --serve --port=8080",
    "serve": "cross-env ELEVENTY_SITE_ORIGIN=http://localhost:8080 ELEVENTY_CANONICAL_ORIGIN=http://localhost:8080 eleventy --serve --port=8080",
    "debug": "DEBUG=Eleventy* eleventy",
    "search-index": "pagefind --site _site"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.1",
    "@11ty/eleventy-fetch": "^5.1.3",
    "@11ty/eleventy-img": "^7.0.0",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "github-slugger": "^2.0.0",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.26",
    "postcss-csso": "^6.0.1",
    "postcss-import": "^17.0.0",
    "postcss-normalize": "^13.0.1",
    "postcss-reporter": "^7.1.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "svgo": "^4.0.2"
  }
}
